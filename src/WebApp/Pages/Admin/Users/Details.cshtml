@page "{id}"
@using Enfo.Domain.Identity
@model DetailsModel
@{
    ViewData["Title"] = "User Profile: " + Model.DisplayStaff.Name;
}

<h1>User Profile</h1>
<hr />

<h2>
    @Model.DisplayStaff.Name
    @if (string.Equals(Model.DisplayStaff.Email, User.Identity?.Name, StringComparison.OrdinalIgnoreCase))
    {
        <a asp-page="/Account/Index">
            <span class="badge bg-info-subtle border border-info-subtle text-info-emphasis text-uppercase rounded-pill">You</span>
        </a>
    }
</h2>

<dl class="row">
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.DisplayStaff.Email</dd>
</dl>
<hr />

<h3>Roles</h3>

@if (User.IsInRole(AppRole.UserMaintenance))
{
    <p>
        <a asp-page="EditRoles" asp-route-id="@Model.DisplayStaff.Id" class="btn btn-outline-primary btn-sm">
            Edit User Roles
        </a>
    </p>
}

<partial name="Shared/_UserRolesPartial" model="Model.Roles" />
