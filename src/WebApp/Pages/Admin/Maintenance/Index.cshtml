@page
@using Enfo.Domain.Identity
@model MaintenanceIndexModel
@{
    ViewData["Title"] = "Site Maintenance";
}

<h1>@ViewData["Title"]</h1>
<p>These lists are used to populate the drop-down lists when adding or editing Enforcement Orders.</p>
<p>Select a list to view. The @AppRole.SiteMaintenanceRole.DisplayName role is needed to edit a list.</p>

<div class="list-group">
    <a asp-page="./Contacts/Index" class="list-group-item list-group-item-action">@MaintenanceOption.EpdContact.PluralName</a>
    <a asp-page="./LegalAuthorities/Index" class="list-group-item list-group-item-action">@MaintenanceOption.LegalAuthority.PluralName</a>
</div>
