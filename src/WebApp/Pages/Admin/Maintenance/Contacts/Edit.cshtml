@page "{id}"
@using Enfo.WebApp.Pages.Shared.EditorTemplates
@model EditModel
@{
    ViewData["Title"] = $"Edit {EditModel.ThisOption.SingularName}";
    ViewData["NoAnchors"] = "True";
}

<h1>Edit @EditModel.ThisOption.SingularName</h1>
<hr />
<partial name="Admin/Maintenance/_MaintenanceItemEditWarning" model="@EditModel.ThisOption" />

<div class="p-3 border rounded-3 bg-light-subtle">
    <form method="post">
        <div class="row">
            <div class="col-md-8 col-lg-6">
                <div class="mb-3">
                    @Html.EditorFor(model => model.Item.ContactName, EditorTemplate.Input)
                </div>
                <div class="mb-3">
                    @Html.EditorFor(model => model.Item.Title, EditorTemplate.Input)
                </div>
                <div class="mb-3">
                    @Html.EditorFor(model => model.Item.Organization, EditorTemplate.Input)
                </div>
            </div>
        </div>
        <div class="row">
            <h3 class="h5">Address</h3>
            <div class="col-md-8 col-lg-6">
                <div class="mb-3">
                    @Html.EditorFor(model => model.Item.Street, EditorTemplate.Input)
                </div>
                <div class="mb-3">
                    @Html.EditorFor(model => model.Item.Street2, EditorTemplate.Input)
                </div>
                <div class="input-group mb-3">
                    @Html.EditorFor(model => model.Item.City, EditorTemplate.Input)
                    @Html.EditorFor(model => model.Item.PostalCode, EditorTemplate.Input)
                </div>
            </div>
        </div>
        <div class="row">
            <h3 class="h5">Communication</h3>
            <div class="col-md-8 col-lg-6">
                <div class="mb-3">
                    @Html.EditorFor(model => model.Item.Telephone, EditorTemplate.Input)
                </div>
                <div class="mb-3">
                    @Html.EditorFor(model => model.Item.Email, EditorTemplate.Input)
                </div>
            </div>
        </div>

        <div class="mb-3">
            @Html.EditorFor(model => model.Item.Active, EditorTemplate.Checkbox)
        </div>
        <div class="mt-3 mb-1">
            <button type="submit" class="btn btn-primary me-2">Save Changes</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
        <div class="text-danger-emphasis mt-3">* denotes a required field</div>
    </form>
</div>

@section Scripts
{
    <partial name="Shared/_ValidationScriptsPartial" />
}
