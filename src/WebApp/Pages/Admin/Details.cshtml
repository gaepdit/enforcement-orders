@page "{id}"
@using Enfo.Domain.Identity
@using Enfo.WebApp.Pages.Shared
@using Enfo.WebApp.Pages.Shared.DisplayTemplates
@model DetailsModel
@{
    ViewData["Title"] = $"Enforcement Order {Model.Item.OrderNumber}";
}

<div class="container-full">
    <div class="row justify-content-between align-items-baseline g-0 mt-1 mb-3">
        <div class="col">
            <h1>
                <em class="text-info-emphasis">Admin View:</em>
                Enforcement Order <span class="text-nowrap">@Model.Item.OrderNumber</span>
            </h1>
        </div>
        <div class="col-auto d-print-none ms-2">
            @if (Model.Item.IsPublic)
            {
                <a asp-page="/Details" asp-route-id="@Model.Item.Id"
                   class="link-underline link-underline-opacity-25 link-underline-opacity-100-hover link-offset-2">
                    <partial name="Shared/_AppIconsPartial" model="@AppIcon.People"
                             view-data="new ViewDataDictionary(ViewData)" view-data-CssClass="@("me-2")" />
                    Go to public view
                </a>
            }
            else
            {
                <text>Not publicly viewable</text>
            }
        </div>
    </div>
</div>

@if (Model.Item.Deleted)
{
    <div class="callout callout-danger mb-3">
        <div class="container-full">
            <h4 class="text-danger-emphasis">Deleted</h4>
        </div>
        <p>
            This enforcement order has been deleted and will not be displayed to the public.
        </p>
    </div>
}

<div class="container">
    <dl class="row">
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.PublicationStatus)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.PublicationStatus)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.FacilityName)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.FacilityName)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.County)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.County) County</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.Cause)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.Cause)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.Requirements)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.Requirements)</dd>
        <dt class="col-sm-4">@(Model.Item.IsExecutedOrder ? "" : "Proposed ")@Html.DisplayNameFor(m => m.Item.SettlementAmount)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.SettlementAmount)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.LegalAuthority)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.LegalAuthority.AuthorityName)</dd>

        @if (Model.Item.IsProposedOrder)
        {
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.ProposedOrderPostedDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.ProposedOrderPostedDate, DisplayTemplate.DateTimeNullableAsShort)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.CommentPeriodClosesDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.CommentPeriodClosesDate, DisplayTemplate.DateTimeNullableAsShort)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.CommentContact)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.CommentContact, DisplayTemplate.ContactView)</dd>
        }

        @if (Model.Item.IsExecutedOrder)
        {
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.ExecutedDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.ExecutedDate, DisplayTemplate.DateTimeNullableAsShort)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.ExecutedOrderPostedDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.ExecutedOrderPostedDate, DisplayTemplate.DateTimeNullableAsShort)</dd>
        }

        @if (Model.Item.IsHearingScheduled)
        {
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.IsHearingScheduled)</dt>
            <dd class="col-sm-8">
                <p>
                    <em>@Html.DisplayNameFor(m => m.Item.HearingDate)</em><br />
                    @Html.DisplayFor(m => m.Item.HearingDate, DisplayTemplate.DateTimeNullableAsShort)
                </p>
                <p>
                    <em>@Html.DisplayNameFor(m => m.Item.HearingLocation)</em><br />
                    @Html.DisplayFor(m => m.Item.HearingLocation)
                </p>
                <p>
                    <em>@Html.DisplayNameFor(m => m.Item.HearingCommentPeriodClosesDate)</em><br />
                    @Html.DisplayFor(m => m.Item.HearingCommentPeriodClosesDate, DisplayTemplate.DateTimeNullableAsShort)
                </p>
                <p>
                    <em>@Html.DisplayNameFor(m => m.Item.HearingContact)</em><br />
                </p>
                @Html.DisplayFor(m => m.Item.HearingContact, DisplayTemplate.ContactView)
            </dd>
        }

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.Attachments)</dt>
        <dd class="col-sm-8" id="attachments">
            @if (Model.Item.Attachments.Count == 0)
            {
                <em>None</em>
            }
            else
            {
                <table class="table table-hover" aria-label="File attachments">
                    <thead>
                    <tr>
                        <th scope="col">File</th>
                        <th scope="col">Size</th>
                        <th scope="col">Date Uploaded</th>
                        @if (User.IsInRole(AppRole.OrderAdministrator) && !Model.Item.Deleted)
                        {
                            <th scope="col">Actions</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Item.Attachments)
                    {
                        <tr class="align-middle">
                            <th class="fw-normal" scope="row">
                                <a asp-page="/Attachment" asp-route-id="@item.Id.ToString()" asp-route-fileName="@item.FileName" target="_blank"
                                   class="text-decoration-hover link-offset-2 no-external-link" target="_blank">
                                    <partial name="Shared/_AppIconsPartial" model="@AppIcon.Pdf"
                                             view-data="new ViewDataDictionary(ViewData)" view-data-CssClass="@("me-1")" />@item.FileName
                                </a>
                            </th>
                            <td>@Html.DisplayFor(m => item.Size, DisplayTemplate.FileSize)</td>
                            <td>@Html.DisplayFor(m => item.DateUploaded, DisplayTemplate.DateTimeAsShort)</td>
                            @if (User.IsInRole(AppRole.OrderAdministrator) && !Model.Item.Deleted)
                            {
                                <td>
                                    <form method="post" asp-page-handler="DeleteAttachment" enctype="multipart/form-data">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        <input type="hidden" name="attachmentId" value="@item.Id.ToString()" />
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            }
            @if (User.IsInRole(AppRole.OrderAdministrator) && !Model.Item.Deleted)
            {
                <div class="p-3 mt-3 rounded-3 bg-light-subtle border">
                    <form method="post" asp-page-handler="AddAttachment" enctype="multipart/form-data">
                        <h5>Add attachment</h5>
                        <div class="mb-3"><em>Only PDF documents are allowed.</em></div>
                        <div class="mb-3">
                            <input asp-for="Attachment" class="filesUploadInput" accept=".pdf" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Attach selected file</button>
                        <input asp-for="Id" type="hidden" />
                    </form>
                </div>
            }
        </dd>
    </dl>

    @if (User.IsInRole(AppRole.OrderAdministrator))
    {
        <div>
            @if (Model.Item.Deleted)
            {
                <a asp-page="Restore" asp-route-id="@Model.Item.Id.ToString()" class="btn btn-outline-warning">Restore deleted order</a>
            }
            else
            {
                <a asp-page="Edit" asp-route-id="@Model.Item.Id.ToString()" class="btn btn-outline-primary me-2">Edit</a>
                <a asp-page="Delete" asp-route-id="@Model.Item.Id.ToString()" class="btn btn-outline-danger">Delete</a>
            }
        </div>
    }
</div>
