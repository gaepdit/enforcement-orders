@page
@model AccountIndexModel
@{
    ViewData["Title"] = "Account Profile";
}

<h1>@ViewData["Title"]</h1>
<hr />

<h2>@Model.DisplayStaff.Name</h2>

<dl class="row">
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.DisplayStaff.Email</dd>
</dl>

<div class="mb-3">
    <form class="d-inline-block" asp-page="Logout" method="post">
        <button type="submit" class="btn btn-danger">Sign out</button>
    </form>
</div>

<h3>Roles</h3>

<partial name="Shared/_UserRolesPartial" model="Model.Roles" />

<environment include="Local, Development">
    <details class="p-3 border rounded-3 bg-info-subtle">
        <summary class="rounded-1 p-1"><h3 class="h4 ps-1 m-0 no-anchor d-inline-block">Claims</h3></summary>

        <dl class="p-3">
            @foreach (var claim in Model.User.Claims)
            {
                <dt>@claim.Type</dt>
                <dd class="text-body-secondary">@claim.Value</dd>
            }
        </dl>
    </details>
</environment>
