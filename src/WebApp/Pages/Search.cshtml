@page
@using Enfo.Domain.EnforcementOrders.Specs
@using Enfo.WebApp.Models
@using Enfo.WebApp.Platform.PageModelHelpers
@model Search
@{
    ViewData["Title"] = "Search Enforcement Orders";
}

<div class="container-full">
    <div class="row justify-content-between align-items-baseline g-0 mt-1 mb-3">
        <div class="col"><h1>@ViewData["Title"]</h1></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="col-auto d-print-none ms-2">
                <a asp-page="/Admin/Search"
                   class="link-underline link-underline-opacity-25 link-underline-opacity-100-hover link-offset-2">
                    <svg class="bi me-2">
                        <use href="@Url.Content("~/images/app-icons.svg")#app-icon-person-badge"></use>
                    </svg>
                    Go to admin search
                </a>
            </div>
        }
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="p-3 rounded-3 bg-light-subtle border col-lg-9">
            <div class="text-body-secondary pb-2">
                <em>All fields are optional.</em>
            </div>
            <form method="get" asp-page-handler="Search" asp-fragment="SearchResults">
                <div class="row">
                    <div class="col-md mb-3">
                        <div class="form-floating">
                            <input asp-for="Spec.Facility" class="form-control" />
                            <label asp-for="Spec.Facility" class="form-label"></label>
                        </div>
                    </div>
                    <div class="col-md mb-3">
                        <div class="form-floating">
                            <select asp-for="Spec.County" asp-items="@CommonSelectLists.CountiesSelectList" class="form-select">
                                <option value="">(any)</option>
                            </select>
                            <label asp-for="Spec.County" class="form-label"></label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md mb-3">
                        <div class="form-floating">
                            <input asp-for="Spec.OrderNumber" class="form-control" />
                            <label asp-for="Spec.OrderNumber" class="form-label"></label>
                        </div>
                    </div>
                    <div class="col-md mb-3">
                        <div class="form-floating">
                            <select asp-for="Spec.LegalAuth" asp-items="Model.LegalAuthoritiesSelectList" class="form-select">
                                <option value="">(any)</option>
                            </select>
                            <label asp-for="Spec.LegalAuth" class="form-label"></label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md mb-3">
                        <div class="form-floating">
                            <select asp-for="Spec.Status" asp-items="@Html.GetEnumSelectList<ActivityState>()" class="form-select">
                            </select>
                            <label asp-for="Spec.Status" class="form-label"></label>
                        </div>
                    </div>
                    <div class="col-md mb-3">
                        <div class="input-group">
                            <div class="form-floating">
                                <input asp-for="Spec.FromDate" class="form-control" />
                                <label asp-for="Spec.FromDate" class="form-label"></label>
                            </div>
                            <div class="form-floating">
                                <input asp-for="Spec.TillDate" class="form-control" />
                                <label asp-for="Spec.TillDate" class="form-label"></label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 mb-1">
                    <button id="SearchButton" type="submit" class="btn btn-lg btn-primary col-4 me-2">Search</button>
                    <a asp-page="Search" class="btn btn-lg btn-outline-secondary col-4 col-md-3">Clear Form</a>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.ShowResults)
{
    <div id="search-results">
        @if (Model.OrdersList.CurrentCount == 0)
        {
            <h3>No results found.</h3>
        }
        else
        {
            <partial name="_PaginationCount" model="Model.OrdersList" />
            @await Html.PartialAsync("_PaginationNav", new PaginationNavModel(Model.OrdersList, Model.Spec.AsRouteValues()))

            <table class="usa-table-borderless gaepd-table-responsive" aria-label="Enforcement order search results">
                <thead>
                <tr>
                    <th scope="col" class="gaepd-sortable"
                        @if (Model.Spec.Sort == OrderSorting.FacilityAsc)
                        {
                            @:aria-sort="ascending"
                        }
                        else if (Model.Spec.Sort == OrderSorting.FacilityDesc)
                        {
                            @:aria-sort="descending"
                        }
                        data-label="Sort by">
                        <a asp-fragment="search-results" asp-all-route-data="Model.Spec.AsRouteValues()"
                           asp-route-Sort="@(Model.Spec.Sort == OrderSorting.FacilityAsc ? nameof(OrderSorting.FacilityDesc) : nameof(OrderSorting.FacilityAsc))"
                           asp-route-handler="search">
                            Facility
                        </a>
                    </th>
                    <th scope="col">Order</th>
                    <th scope="col" colspan="2" class="gaepd-sortable"
                        @if (Model.Spec.Sort == OrderSorting.DateAsc)
                        {
                            @:aria-sort="ascending"
                        }
                        else if (Model.Spec.Sort == OrderSorting.DateDesc)
                        {
                            @:aria-sort="descending"
                        }
                        data-label="Sort by">
                        <a asp-fragment="search-results" asp-all-route-data="Model.Spec.AsRouteValues()"
                           asp-route-Sort="@(Model.Spec.Sort == OrderSorting.DateAsc ? nameof(OrderSorting.DateDesc) : nameof(OrderSorting.DateAsc))"
                           asp-route-handler="search">
                            Status/Date
                        </a>
                    </th>
                </tr>
                </thead>
                <tbody>
                @foreach (var enfo in Model.OrdersList.Items)
                {
                    <tr>
                        <th scope="row" data-label="Facility">
                            @enfo.FacilityName <br />
                            <em>@enfo.County County</em>
                        </th>
                        <td data-label="Order">
                            @Html.DisplayFor(modelItem => enfo.OrderNumber)<br />
                            <em>@Html.DisplayFor(m => enfo.LegalAuthority.AuthorityName)</em>
                        </td>
                        <td data-label="Status/Date">
                            @if (enfo.IsExecutedOrder)
                            {
                                <strong>Executed&nbsp;On</strong>
                                <br />
                                @Html.DisplayFor(m => enfo.ExecutedDate)
                            }
                            else if (enfo.IsProposedOrder)
                            {
                                <strong>Proposed&nbsp;On</strong>
                                <br />
                                @Html.DisplayFor(m => enfo.ProposedOrderPostedDate)
                            }
                            else
                            {
                                <strong>error</strong>
                            }
                        </td>
                        <td class="gaepd-tablecell-nolabel">
                            <a asp-page="/Details" asp-route-id="@enfo.Id.ToString()">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            @await Html.PartialAsync("_PaginationNav", new PaginationNavModel(Model.OrdersList, Model.Spec.AsRouteValues()))
        }
    </div>
}

@section Styles
{
    <link rel="stylesheet" href="~/lib/jqueryui/themes/base/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/lib/jqueryui/themes/base/theme.min.css" />
}

@section Scripts
{
    <script src="~/lib/jqueryui/jquery-ui.min.js"></script>
    <script src="~/js/datepicker.js"></script>
    <script src="~/js/formSearch.js"></script>
}
