@using Enfo.WebApp.Models
@model Enfo.WebApp.Models.DisplayMessage?
@if (Model != null)
{
    <div class="alert @Model.AlertClass alert-dismissible fade show d-flex align-items-center" role="alert">
        @switch (Model.Context)
        {
            case DisplayMessage.AlertContext.Success:
                <partial name="Shared/_AppIconsPartial" model="@AppIcon.CheckIcon" />
                break;

            case DisplayMessage.AlertContext.Info:
                <partial name="Shared/_AppIconsPartial" model="@AppIcon.InfoIcon" />
                break;

            case DisplayMessage.AlertContext.Danger:
            case DisplayMessage.AlertContext.Warning:
                <partial name="Shared/_AppIconsPartial" model="@AppIcon.WarningIcon" />
                break;

            default:
                throw new ArgumentOutOfRangeException();
        }

        <div class="ms-3">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
