@page "{id}"
@using Enfo.WebApp.Pages.Shared.DisplayTemplates
@model DetailsModel
@{
    ViewData["Title"] = $"Enforcement Order {Model.Item.OrderNumber}";
}

<div class="container-full">
    <div class="row justify-content-between align-items-baseline g-0 mt-1 mb-3">
        <div class="col"><h1>Enforcement Order <span class="text-nowrap">@Model.Item.OrderNumber</span></h1></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="col-auto d-print-none ms-2">
                <a asp-page="/Admin/Details" asp-route-id="@Model.Item.Id"
                   class="link-underline link-underline-opacity-25 link-underline-opacity-100-hover link-offset-2">
                    <svg class="bi me-2">
                        <use href="@Url.Content("~/images/app-icons.svg")#app-icon-person-badge"></use>
                    </svg>
                    Go to admin view
                </a>
            </div>
        }
    </div>
</div>

<div class="container">
    <dl class="row">
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.FacilityName)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.FacilityName)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.County)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.County) County</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.Cause)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.Cause)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.Requirements)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.Requirements)</dd>
        <dt class="col-sm-4">@(Model.Item.IsExecutedOrder ? "" : "Proposed ")@Html.DisplayNameFor(m => m.Item.SettlementAmount)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.SettlementAmount)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.LegalAuthority)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.LegalAuthority.AuthorityName)</dd>

        @if (Model.Item.IsPublicProposedOrder)
        {
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.ProposedOrderPostedDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.ProposedOrderPostedDate, DisplayTemplate.DateTimeNullableAsShort)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.CommentPeriodClosesDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.CommentPeriodClosesDate, DisplayTemplate.DateTimeNullableAsShort)</dd>
            @if (Model.Item.CommentPeriodClosesDate.HasValue
                 && Model.Item.CommentPeriodClosesDate.Value >= DateTime.Today
                 && Model.Item.CommentContact != null)
            {
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.CommentContact)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.CommentContact, DisplayTemplate.ContactView)</dd>
            }
        }

        @if (Model.Item.IsPublicExecutedOrder)
        {
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.ExecutedDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.ExecutedDate, DisplayTemplate.DateTimeNullableAsShort)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.ExecutedOrderPostedDate)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Item.ExecutedOrderPostedDate, DisplayTemplate.DateTimeNullableAsShort)</dd>
        }

        @if (Model.Item.IsHearingScheduled)
        {
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.IsHearingScheduled)</dt>
            <dd class="col-sm-8">
                <p>
                    <em>@Html.DisplayNameFor(m => m.Item.HearingDate)</em><br />
                    @Html.DisplayFor(m => m.Item.HearingDate, DisplayTemplate.DateTimeNullableAsShort)
                </p>
                <p>
                    <em>@Html.DisplayNameFor(m => m.Item.HearingLocation)</em><br />
                    @Html.DisplayFor(m => m.Item.HearingLocation)
                </p>
                <p>
                    <em>@Html.DisplayNameFor(m => m.Item.HearingCommentPeriodClosesDate)</em><br />
                    @Html.DisplayFor(m => m.Item.HearingCommentPeriodClosesDate, DisplayTemplate.DateTimeNullableAsShort)
                </p>
                @if (Model.Item.HearingCommentPeriodClosesDate.HasValue
                     && Model.Item.HearingCommentPeriodClosesDate.Value >= DateTime.Today
                     && Model.Item.HearingContact != null)
                {
                    <div><em>@Html.DisplayNameFor(m => m.Item.HearingContact)</em></div>
                    @Html.DisplayFor(m => m.Item.HearingContact, DisplayTemplate.ContactView)
                }
            </dd>
        }

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Item.Attachments)</dt>
        <dd class="col-sm-8">
            @if (Model.Item.Attachments.Count == 0)
            {
                <em>None</em>
            }
            else
            {
                <ul class="gaepd-file-links">
                    @foreach (var item in Model.Item.Attachments)
                    {
                        <li>
                            <a asp-page="/Attachment" asp-route-id="@item.Id.ToString()" asp-route-fileName="@item.FileName" class="gaepd-file-link" target="_blank">
                                @Html.DisplayFor(m => item.FileExtension)
                                @item.FileName
                            </a>
                            (@Html.DisplayFor(m => item.Size), uploaded @Html.DisplayFor(m => item.DateUploaded))
                        </li>
                    }
                </ul>
            }
        </dd>
    </dl>
</div>
